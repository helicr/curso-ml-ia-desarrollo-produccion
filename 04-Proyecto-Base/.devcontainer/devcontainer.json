{
  // SIN PROBAR (escrito en S2 desde la documentacion de dev containers; no se ha abierto ningun Codespace con este archivo).
  // Sirve para tener en el navegador: Python 3.11 (el mismo minor que la imagen), las dependencias del proyecto y un Docker real.
  // Debe estar en la RAIZ de TU repositorio (carpeta .devcontainer/), no dentro de una subcarpeta.
  "name": "ia-mlops (S2: API y Docker)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    // Docker dentro del Codespace, para poder ejecutar «docker build» y «docker run» (sin esto, `docker` no existe)
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install -r requirements-dev.txt",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "API ia-mlops", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
