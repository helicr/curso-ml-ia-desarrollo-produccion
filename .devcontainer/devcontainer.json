{
  // SIN PROBAR (escrito en S2 a partir de la documentacion de dev containers; no se ha abierto ningun Codespace con este archivo).
  // Codespace del curso: Python 3.11 (el mismo minor que la imagen de la API) y Docker dentro del Codespace.
  // El proyecto esta en la subcarpeta 04-Proyecto-Base: abre la terminal y ejecuta  cd 04-Proyecto-Base
  // (Si trabajas en TU repositorio con el proyecto en la raiz, usa 04-Proyecto-Base/.devcontainer/devcontainer.json copiado a la raiz.)
  "name": "Curso ML e IA (S2: API y Docker)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    // Sin esto, el comando `docker` no existe dentro del Codespace
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install -r 04-Proyecto-Base/requirements-dev.txt",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "API ia-mlops", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
