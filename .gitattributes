* text=auto
*.html linguist-documentation

# Scripts de Windows: saltos de linea CRLF al clonar (CMD es mas fragil con LF)
*.cmd text eol=crlf
*.bat text eol=crlf
# Scripts de shell de las pruebas: LF
*.sh text eol=lf

# Datos originales de terceros: Git no debe tocar ni un byte (los sha256 de SHA256SUMS deben coincidir tras clonar, también en Windows)
02-Proyecto-Transversal/datos/** -text
*.xls binary

# PDF: binarios, sin conversion de saltos de linea
*.pdf binary
